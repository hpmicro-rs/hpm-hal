# 示例代码编写规范

## 基本结构模板

### 标准示例框架
```rust
#![no_main]
#![no_std]

// 导入必要的trait
use embedded_io::Write as _;
use hpm_hal::gpio::{Level, Output, Speed};
use hpm_hal::uart::Uart;
use {defmt_rtt as _, hpm_hal as hal};

#[hal::entry]
fn main() -> ! {
    // 1. 初始化HAL
    let p = hal::init(Default::default());
    
    // 2. 配置外设
    let config = hal::uart::Config::default();
    let mut uart = Uart::new_blocking(p.UART0, p.PA01, p.PA00, config).unwrap();
    
    // 3. 主循环
    loop {
        // 应用逻辑
    }
}

#[panic_handler]
unsafe fn panic(_info: &core::panic::PanicInfo) -> ! {
    defmt::info!("panic!");
    loop {}
}
```

## 外设使用模式

### GPIO示例
```rust
// LED控制
let mut led = Output::new(p.PA10, Level::Low, Speed::default());

// 基本操作
led.set_high();
led.set_low();
led.toggle();

// 按钮输入
let button = Input::new(p.PB02, Pull::Up);
if button.is_low() {
    // 按钮按下
}
```

### UART示例
```rust
// 阻塞模式
let mut uart = hal::uart::Uart::new_blocking(
    p.UART0, 
    p.PA01,  // TX pin
    p.PA00,  // RX pin
    config
).unwrap();

// 写入数据
writeln!(uart, "Hello, World!").unwrap();

// 读取数据
let mut buf = [0u8; 4];
uart.blocking_read(&mut buf).unwrap();
```

### I2C示例
```rust
// I2C配置
let mut i2c_config = hal::i2c::Config::default();
i2c_config.frequency = 400_000; // 400kHz

let mut i2c = hal::i2c::I2c::new_blocking(
    p.I2C0,
    p.PB02, // SCL
    p.PB03, // SDA
    i2c_config
).unwrap();

// 读写操作
let mut data = [0u8; 1];
i2c.blocking_write_read(0x50, &[0x00], &mut data).unwrap();
```

### SPI示例
```rust
// SPI配置
let mut spi_config = hal::spi::Config::default();
spi_config.frequency = 1_000_000; // 1MHz

let mut spi = hal::spi::Spi::new_blocking(
    p.SPI1,
    p.PA27, // SCK
    p.PA28, // MOSI
    p.PA29, // MISO
    spi_config
).unwrap();

// 数据传输
let mut read_buf = [0u8; 4];
spi.blocking_transfer(&mut read_buf, &[0x01, 0x02, 0x03, 0x04]).unwrap();
```

## 异步示例模式

### Embassy集成
```rust
use embassy_executor::Spawner;
use embassy_time::{Duration, Timer};
use hpm_hal::bind_interrupts;

bind_interrupts!(struct Irqs {
    UART0 => hpm_hal::uart::InterruptHandler<hal::peripherals::UART0>;
});

#[embassy_executor::main]
async fn main(_spawner: Spawner) {
    let p = hal::init(Default::default());
    
    // 异步外设初始化
    let mut uart = hal::uart::Uart::new(
        p.UART0,
        p.PA01,
        p.PA00,
        Irqs,
        p.DMA,
        config
    ).unwrap();
    
    loop {
        uart.write_all(b"Hello async world!\r\n").await.unwrap();
        Timer::after(Duration::from_secs(1)).await;
    }
}
```

### 异步GPIO
```rust
let mut button = Input::new(p.PB02, Pull::Up);
let mut led = Output::new(p.PA10, Level::Low, Speed::default());

loop {
    button.wait_for_falling_edge().await;
    led.toggle();
    Timer::after(Duration::from_millis(50)).await; // 防抖
}
```

